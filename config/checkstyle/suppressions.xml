<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- DesignForExtension does not fit Spring/AOP patterns where classes need to be proxied. -->
    <suppress checks="DesignForExtension" files=".*"/>

    <!-- Tests use descriptive method names with underscores and may include magic numbers. -->
    <suppress checks="MethodName" files=".*Test\.java"/>
    <suppress checks="MagicNumber" files=".*Test\.java"/>
    <suppress checks="ParameterNumber" files=".*Test\.java"/>
    <suppress checks="LineLength" files=".*Test\.java"/>

    <!-- Document classes commonly need many fields (DTOs / Mongo documents). -->
    <suppress checks="VisibilityModifier" files=".*Document\.java"/>
    <suppress checks="HiddenField" files=".*Document\.java"/>
    <suppress checks="ParameterNumber" files=".*Document\.java"/>

    <!-- Config/Adapter/Properties classes may use numeric literals for timeouts, sizes, retries. -->
    <suppress checks="MagicNumber" files=".*Config\.java"/>
    <suppress checks="MagicNumber" files=".*Adapter\.java"/>
    <suppress checks="MagicNumber" files=".*Properties\.java"/>

    <!-- googleJavaFormat AOSP produces inline empty bodies "{ }" that Checkstyle flags. -->
    <suppress checks="WhitespaceAround" files=".*\.java" lines="1-1000"/>

    <!-- The Spring Boot application entrypoint uses public main. -->
    <suppress checks="HideUtilityClassConstructor" files=".*/OrderWorkerApplication\.java"/>

    <!-- Project preference: do not force final on parameters. -->
    <suppress checks="FinalParameters" files=".*"/>

    <!-- TODO/FIXME allowed during development. -->
    <suppress checks="TodoComment" files=".*"/>
</suppressions>
