# Resilient Order Enricher — sample environment configuration.
# Copy to .env and adjust to your local stack. Defaults below match docker-compose.

# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDERS_TOPIC=orders
KAFKA_CONSUMER_GROUP=order-worker-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=10
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_PROCESSING_TIMEOUT=30s

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=order_worker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3s

# Go enrichment API
ENRICHER_API_BASE_URL=http://localhost:8080
ENRICHER_API_CONNECT_TIMEOUT=5000
ENRICHER_API_READ_TIMEOUT=10000
ENRICHER_API_WRITE_TIMEOUT=10000
ENRICHER_API_RESPONSE_TIMEOUT=30000

# Background scheduler that retries Redis-stored failures
FAILED_MESSAGE_SCHEDULER_ENABLED=true
FAILED_MESSAGE_RETRY_INTERVAL=30000
